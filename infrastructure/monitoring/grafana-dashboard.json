{
  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "datasource": "$datasource",
        "expr": "changes(process_uptime_seconds{job=\"$job\", instance=\"$instance\"}[1m]) > 0",
        "step": "60s",
        "tagKeys": ["instance"],
        "titleFormat": "Deployment",
        "textFormat": "Application restarted on {{instance}}",
        "enable": true,
        "iconColor": "#5794F2"
      }
    ]
  },
  "id": null,
  "uid": "nodejs-hello-world",
  "title": "Node.js Hello World Dashboard",
  "tags": ["nodejs", "http", "monitoring"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "schemaVersion": 30,
  "version": 1,
  "description": "Dashboard for monitoring the Node.js Hello World application",
  "links": [
    {
      "title": "Prometheus",
      "url": "/prometheus",
      "icon": "external link",
      "targetBlank": true,
      "tooltip": "Open Prometheus UI"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Application Status",
      "type": "stat",
      "datasource": "$datasource",
      "targets": [
        {
          "expr": "up{job=\"$job\", instance=\"$instance\"}",
          "legendFormat": "Status"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "mappings": [
          {
            "type": "value",
            "options": {
              "0": {
                "text": "Down",
                "color": "red"
              },
              "1": {
                "text": "Up",
                "color": "green"
              }
            }
          }
        ]
      },
      "description": "Current status of the Node.js Hello World application"
    },
    {
      "id": 2,
      "title": "Process Uptime",
      "type": "gauge",
      "datasource": "$datasource",
      "targets": [
        {
          "expr": "process_uptime_seconds{job=\"$job\", instance=\"$instance\"}",
          "legendFormat": "Uptime"
        }
      ],
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {
              "color": "red",
              "value": 0
            },
            {
              "color": "yellow",
              "value": 60
            },
            {
              "color": "green",
              "value": 300
            }
          ]
        },
        "unit": "s"
      },
      "description": "Time since the application process started"
    },
    {
      "id": 3,
      "title": "Request Rate",
      "type": "timeseries",
      "datasource": "$datasource",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"$job\", instance=\"$instance\"}[1m])) by (path)",
          "legendFormat": "{{path}}"
        }
      ],
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "Requests/sec",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "reqps"
        }
      },
      "description": "HTTP request rate per second by path"
    },
    {
      "id": 4,
      "title": "Response Time",
      "type": "timeseries",
      "datasource": "$datasource",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(http_request_duration_seconds_bucket{job=\"$job\", instance=\"$instance\", path=\"/hello\"}[1m])) by (le))",
          "legendFormat": "50th percentile"
        },
        {
          "expr": "histogram_quantile(0.9, sum(rate(http_request_duration_seconds_bucket{job=\"$job\", instance=\"$instance\", path=\"/hello\"}[1m])) by (le))",
          "legendFormat": "90th percentile"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"$job\", instance=\"$instance\", path=\"/hello\"}[1m])) by (le))",
          "legendFormat": "95th percentile"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"$job\", instance=\"$instance\", path=\"/hello\"}[1m])) by (le))",
          "legendFormat": "99th percentile"
        }
      ],
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "Response Time",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "unit": "s"
        }
      },
      "description": "HTTP response time percentiles for /hello endpoint"
    },
    {
      "id": 5,
      "title": "Error Rate",
      "type": "timeseries",
      "datasource": "$datasource",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"$job\", instance=\"$instance\", status!=\"200\"}[1m])) / sum(rate(http_requests_total{job=\"$job\", instance=\"$instance\"}[1m])) * 100",
          "legendFormat": "Error Rate"
        }
      ],
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "Error Rate",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "percent"
        }
      },
      "description": "Percentage of HTTP requests resulting in error responses"
    },
    {
      "id": 6,
      "title": "HTTP Status Codes",
      "type": "piechart",
      "datasource": "$datasource",
      "targets": [
        {
          "expr": "sum(increase(http_requests_total{job=\"$job\", instance=\"$instance\"}[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        },
        "pieType": "pie",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "Distribution of HTTP status codes in the last 5 minutes"
    },
    {
      "id": 7,
      "title": "Memory Usage",
      "type": "timeseries",
      "datasource": "$datasource",
      "targets": [
        {
          "expr": "nodejs_memory_usage_bytes{job=\"$job\", instance=\"$instance\"}",
          "legendFormat": "{{type}}"
        }
      ],
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "Memory",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "bytes"
        }
      },
      "description": "Node.js process memory usage"
    },
    {
      "id": 8,
      "title": "Event Loop Lag",
      "type": "timeseries",
      "datasource": "$datasource",
      "targets": [
        {
          "expr": "nodejs_eventloop_lag_seconds{job=\"$job\", instance=\"$instance\"}",
          "legendFormat": "Event Loop Lag"
        }
      ],
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "Lag",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "unit": "s"
        }
      },
      "description": "Node.js event loop lag in seconds"
    },
    {
      "id": 9,
      "title": "Requests by Path",
      "type": "barchart",
      "datasource": "$datasource",
      "targets": [
        {
          "expr": "sum(increase(http_requests_total{job=\"$job\", instance=\"$instance\"}[5m])) by (path)",
          "legendFormat": "{{path}}"
        }
      ],
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "Requests",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 100,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineWidth": 0,
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        }
      },
      "description": "Total HTTP requests by path in the last 5 minutes"
    },
    {
      "id": 10,
      "title": "Alert Status",
      "type": "table",
      "datasource": "$datasource",
      "targets": [
        {
          "expr": "ALERTS{job=\"$job\", instance=\"$instance\"}",
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "displayMode": "auto",
            "filterable": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "alertstate"
            },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "firing": {
                        "text": "FIRING",
                        "color": "red"
                      },
                      "pending": {
                        "text": "PENDING",
                        "color": "yellow"
                      },
                      "inactive": {
                        "text": "INACTIVE",
                        "color": "green"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "description": "Current status of Prometheus alerts"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "description": "Prometheus data source selection"
      },
      {
        "name": "job",
        "type": "query",
        "datasource": "$datasource",
        "query": "label_values(up, job)",
        "regex": "/.*nodejs.*/",
        "description": "Filter metrics by Prometheus job"
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": "$datasource",
        "query": "label_values(up{job=~\"$job\"}, instance)",
        "description": "Filter metrics by instance"
      }
    ]
  }
}