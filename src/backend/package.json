{
  "name": "node-http-hello-world",
  "version": "1.0.0",
  "description": "A simple Node.js HTTP server application that exposes a single REST endpoint /hello which returns 'Hello world'",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint .",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "node",
    "http",
    "server",
    "hello-world",
    "example"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.44.0",
    "jest": "^29.6.1",
    "nodemon": "^2.0.22",
    "supertest": "^6.3.3"
  },
  "dependencies": {},
  "jest": {
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}